        try{JSONObject x=src==null?new JSONObject():JsonUtil.deepCopy(src);LinearLayout f=form();EditText date=dateInput("Tarih",x.optString("date",LocalDate.now().toString()));EditText cc=input("Müşteri Kodu",x.optString("customerCode"));EditText cn=input("Müşteri Adı",x.optString("customerName"));EditText person=input("Görüşülen Kişi",x.optString("contactPerson"));EditText status=input("Durum",x.optString("status","Görüşüldü"));EditText note=input("Not",x.optString("note"));EditText next=dateInput("Sonraki Ziyaret",x.optString("nextVisitDate"));addAll(f,date,cc,cn,person,status,note,next);AlertDialog.Builder b=new AlertDialog.Builder(this).setTitle(src==null?"Yeni Ziyaret":"Ziyareti Düzenle").setView(f).setPositiveButton("Kaydet",(d,w)->{try{x.put("date",date.getText().toString()).put("customerCode",cc.getText().toString().trim()).put("customerName",cn.getText().toString().trim()).put("contactPerson",person.getText().toString().trim()).put("status",status.getText().toString().trim()).put("note",note.getText().toString().trim()).put("nextVisitDate",next.getText().toString()).put("visitor",store.currentUserName()).put("visitorId",store.currentUserId());if(JsonUtil.s(x,"customerName").isEmpty())throw new IllegalArgumentException("Müşteri adı zorunludur");store.upsertVisit(x);render();}catch(Exception e){toast(e.getMessage());}}).setNegativeButton("İptal",null);if(src!=null&&store.hasPermission("visit.delete"))b.setNeutralButton("Sil",(d,w)->{try{store.delete("visit",JsonUtil.s(x,"id"));render();}catch(Exception e){toast(e.getMessage());}});b.show();}catch(Exception e){toast(e.getMessage());}
    }

